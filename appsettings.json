{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Scraping": {
    "SourceUrlTemplate": "https://www.bing.com/images/search?q={make}+{model}+{year}",
    "ImageXPath": "//img[@src]",
    "MaxResults": 10,
    "MaxAllowedResults": 50
  }
}
